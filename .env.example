# ==============================
# Trading Platform - Environment Variables
# ==============================

# --- Server Configuration ---
NODE_ENV=development
PORT=4040

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/trading-platform

# --- Application ---
NAME=my-trading-platform

# --- Web Push Notifications ---
WEB_PUSH_PUBLIC_KEY=your_web_push_public_key
WEB_PUSH_PRIVATE_KEY=your_web_push_private_key
WEB_PUSH_SUBJECT=mailto:admin@example.com

# --- Telegram Integration ---
# (Add your Telegram API credentials here if needed)

# --- JWT Secret ---
# JWT_SECRET=your_jwt_secret_here
